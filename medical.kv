#:import MDTopAppBar kivymd.uix.toolbar.MDTopAppBar
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import MDFlatButton kivymd.uix.button.MDFlatButton
#:import MDLabel kivymd.uix.label.MDLabel
#:import MDCard kivymd.uix.card.MDCard
#:import MDScrollView kivymd.uix.scrollview.MDScrollView
#:import MDBoxLayout kivymd.uix.boxlayout.MDBoxLayout
#:import dp kivy.metrics.dp

<ResultCard>:
    orientation: "horizontal"
    padding: 0
    spacing: 0
    size_hint_y: None
    height: dp(85)
    radius: [dp(12),]
    elevation: 2
    md_bg_color: 1, 1, 1, 1

    MDBoxLayout:
        size_hint_x: None
        width: dp(8)
        canvas.before:
            Color:
                rgba: root.accent_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(12), 0, 0, dp(12)]

    BoxLayout:
        orientation: "vertical"
        padding: dp(14), dp(8), dp(14), dp(8)
        spacing: dp(2)

        BoxLayout:
            size_hint_y: None
            height: dp(28)
            
            Label:
                text: root.abbr
                bold: True
                font_size: '20sp'
                color: root.accent_color
                size_hint_x: None
                width: self.texture_size[0]
                text_size: None, None
                valign: 'middle'
                halign: 'left'

            Widget:

            Label:
                text: root.category
                font_size: '12sp'
                color: 0.5, 0.5, 0.5, 1
                size_hint_x: None
                width: self.texture_size[0]
                text_size: None, None
                valign: 'middle'
                halign: 'right'

        Label:
            text: root.full_name
            font_size: '15sp'
            color: 0.2, 0.2, 0.2, 1
            size_hint_y: None
            height: dp(36)
            text_size: self.width, None
            valign: "top"
            halign: "left"

<MedicalRoot>:
    orientation: "vertical"
    md_bg_color: 0.96, 0.96, 0.96, 1

    MDTopAppBar:
        title: "Medical Abbreviations"
        elevation: 4
        left_action_items: [["medical-bag", lambda x: None]]
        md_bg_color: app.theme_cls.primary_color
        specific_text_color: 1, 1, 1, 1

    MDBoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: dp(32)
        padding: [dp(20), 0, dp(20), 0]
        md_bg_color: app.theme_cls.primary_color

        MDLabel:
            text: root.stats_text
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 0.85
            valign: "middle"

    MDCard:
        size_hint_y: None
        height: dp(140)
        padding: [dp(16), dp(8), dp(16), dp(16)]
        spacing: dp(10)
        radius: [0, 0, dp(20), dp(20)]
        elevation: 0
        md_bg_color: app.theme_cls.primary_color
        orientation: "vertical"

        TextInput:
            id: search_input
            hint_text: "Enter abbreviation (HTN, MI, COPD...)"
            multiline: False
            size_hint_y: None
            height: dp(48)
            background_normal: ''
            background_active: ''
            background_color: 1, 1, 1, 1
            foreground_color: 0.1, 0.1, 0.1, 1
            cursor_color: 0.1, 0.1, 0.1, 1
            hint_text_color: 0.5, 0.5, 0.5, 1
            padding: dp(16), dp(12)
            font_size: '16sp'
            on_text_validate: root.search_abbr(search_input.text)

        MDBoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(10)

            Widget:

            MDRaisedButton:
                text: "SEARCH"
                size_hint_x: None
                width: dp(130)
                md_bg_color: 1, 1, 1, 1
                text_color: app.theme_cls.primary_color
                on_release: root.search_abbr(search_input.text)

            MDFlatButton:
                text: "CLEAR"
                size_hint_x: None
                width: dp(100)
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                on_release: root.clear_search()

    MDLabel:
        text: root.status_text
        font_style: "Caption"
        theme_text_color: "Hint"
        size_hint_y: None
        height: dp(36)
        padding: dp(20), 0, dp(20), 0
        valign: "middle"

    MDScrollView:
        MDBoxLayout:
            id: results_container
            orientation: "vertical"
            spacing: dp(10)
            padding: [dp(14), dp(4), dp(14), dp(80)]
            size_hint_y: None
            height: self.minimum_height
